rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);

      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'phoneNumber',
          'role',
          'verificationStatus',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && request.resource.data.verificationStatus == 'notRequested'
        && request.resource.data.isActive == true
        && request.resource.data.fullName is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'phoneNumber',
          'updatedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn()
        && (resource.data.isAvailable == true
          || resource.data.ownerId == request.auth.uid
          || hasSavedRoom(roomId));

      allow create: if isActiveOwner()
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'title',
          'location',
          'monthlyRent',
          'genderPreference',
          'description',
          'imageUrls',
          'isAvailable',
          'createdAt',
          'updatedAt'
        ])
        && hasValidRoomFields(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isActiveOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'title',
          'location',
          'monthlyRent',
          'genderPreference',
          'description',
          'imageUrls',
          'isAvailable',
          'createdAt',
          'updatedAt'
        ])
        && hasValidRoomFields(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isActiveOwner()
        && resource.data.ownerId == request.auth.uid;
    }

    match /savedRooms/{saveId} {
      allow read: if isActiveCustomer()
        && resource.data.customerId == request.auth.uid;

      allow create: if isActiveCustomer()
        && request.resource.data.keys().hasOnly([
          'customerId',
          'roomId',
          'savedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.savedAt == request.time
        && saveId == request.auth.uid + '_' + request.resource.data.roomId
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.isAvailable == true;

      allow update: if false;

      allow delete: if isActiveCustomer()
        && resource.data.customerId == request.auth.uid
        && resource.data.roomId is string
        && saveId == resource.data.customerId + '_' + resource.data.roomId;
    }

    match /inquiries/{inquiryId} {
      allow read: if (isActiveCustomer()
          && resource.data.customerId == request.auth.uid)
        || (isActiveOwner()
          && resource.data.ownerId == request.auth.uid);

      allow create: if isActiveCustomer()
        && request.resource.data.keys().hasOnly([
          'roomId',
          'customerId',
          'ownerId',
          'type',
          'message',
          'status',
          'scheduledVisitAt',
          'hiddenByCustomer',
          'createdAt',
          'updatedAt',
          'roomTitle',
          'roomLocation',
          'customerDisplayName'
        ])
        && hasValidInquiryFields(request.resource.data)
        && request.resource.data.customerId == request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && request.resource.data.ownerId == get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.isAvailable == true
        && request.resource.data.status == 'pending'
        && request.resource.data.scheduledVisitAt == null
        && request.resource.data.hiddenByCustomer == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isValidCustomerInquiryUpdate()
        || isValidOwnerInquiryUpdate();

      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isActiveOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isActiveCustomer() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function hasSavedRoom(roomId) {
      return isActiveCustomer()
        && exists(/databases/$(database)/documents/savedRooms/$(request.auth.uid + '_' + roomId));
    }

    function hasValidRoomFields(data) {
      return data.ownerId is string
        && data.title is string
        && data.title.size() > 0
        && data.location is string
        && data.location.size() > 0
        && data.monthlyRent is number
        && data.monthlyRent > 0
        && data.genderPreference is string
        && data.description is string
        && data.imageUrls is list
        && data.isAvailable is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidInquiryFields(data) {
      return data.roomId is string
        && data.roomId.size() > 0
        && data.customerId is string
        && data.customerId.size() > 0
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.type in ['inquiry', 'visitRequest']
        && data.message is string
        && data.message.size() > 0
        && data.status in [
          'pending',
          'accepted',
          'declined',
          'completed',
          'cancelled'
        ]
        && (data.scheduledVisitAt == null
          || data.scheduledVisitAt is timestamp)
        && data.hiddenByCustomer is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.roomTitle is string
        && data.roomLocation is string
        && data.customerDisplayName is string;
    }

    function isValidCustomerInquiryUpdate() {
      return isActiveCustomer()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hiddenByCustomer',
          'updatedAt'
        ])
        && request.resource.data.hiddenByCustomer == true
        && request.resource.data.updatedAt == request.time;
    }

    function isValidOwnerInquiryUpdate() {
      return isActiveOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'scheduledVisitAt',
          'updatedAt'
        ])
        && hasValidInquiryFields(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && isValidOwnerStatusTransition(
          resource.data.status,
          request.resource.data.status
        )
        && (request.resource.data.scheduledVisitAt == resource.data.scheduledVisitAt
          || (resource.data.type == 'visitRequest'
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'accepted'
            && request.resource.data.scheduledVisitAt is timestamp));
    }

    function isValidOwnerStatusTransition(from, to) {
      return from == to
        || (from == 'pending' && to in ['accepted', 'declined'])
        || (from == 'accepted' && to == 'completed');
    }
  }
}
