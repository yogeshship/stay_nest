rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if (isSignedIn() && isOwner(userId))
        || isAdminReadingPendingOwner(userId);

      allow list: if false;

      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'phoneNumber',
          'role',
          'verificationStatus',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320
        && request.resource.data.role == 'customer'
        && request.resource.data.verificationStatus == 'notRequested'
        && request.resource.data.isActive == true
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSafeOwnProfileUpdate(userId)
        || isVerificationSubmissionUserUpdate(userId)
        || isAdminVerificationUserUpdate(userId);

      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn()
        && (resource.data.isAvailable == true
          || resource.data.ownerId == request.auth.uid
          || hasSavedRoom(roomId));

      allow create: if isVerifiedActiveOwner()
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'title',
          'location',
          'monthlyRent',
          'genderPreference',
          'description',
          'imageUrls',
          'isAvailable',
          'createdAt',
          'updatedAt'
        ])
        && hasValidRoomFields(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isValidRoomAvailabilityUpdate()
        || isValidRoomDetailsUpdate();

      allow delete: if isVerifiedActiveOwner()
        && resource.data.ownerId == request.auth.uid;
    }

    match /savedRooms/{saveId} {
      allow read: if isActiveCustomer()
        && resource.data.customerId == request.auth.uid;

      allow create: if isActiveCustomer()
        && request.resource.data.keys().hasOnly([
          'customerId',
          'roomId',
          'savedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && request.resource.data.roomId.size() <= 128
        && request.resource.data.savedAt == request.time
        && saveId == request.auth.uid + '_' + request.resource.data.roomId
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.isAvailable == true;

      allow update: if false;

      allow delete: if isActiveCustomer()
        && resource.data.customerId == request.auth.uid
        && resource.data.roomId is string
        && saveId == resource.data.customerId + '_' + resource.data.roomId;
    }

    match /inquiries/{inquiryId} {
      allow read: if (isActiveCustomer()
          && resource.data.customerId == request.auth.uid)
        || (isActiveOwner()
          && resource.data.ownerId == request.auth.uid);

      allow create: if isActiveCustomer()
        && request.resource.data.keys().hasOnly([
          'roomId',
          'customerId',
          'ownerId',
          'type',
          'message',
          'status',
          'scheduledVisitAt',
          'hiddenByCustomer',
          'createdAt',
          'updatedAt',
          'roomTitle',
          'roomLocation',
          'customerDisplayName'
        ])
        && hasValidInquiryFields(request.resource.data)
        && request.resource.data.customerId == request.auth.uid
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && request.resource.data.ownerId == get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerId
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.isAvailable == true
        && request.resource.data.roomTitle == get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.title
        && request.resource.data.roomLocation == get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.location
        && request.resource.data.customerDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
        && request.resource.data.status == 'pending'
        && request.resource.data.scheduledVisitAt == null
        && request.resource.data.hiddenByCustomer == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isValidCustomerInquiryUpdate()
        || isValidOwnerInquiryStatusUpdate()
        || isValidOwnerVisitSchedulingUpdate();

      allow delete: if false;
    }

    match /verificationRequests/{ownerId} {
      allow get: if (isActiveOwner()
          && ownerId == request.auth.uid)
        || (isActiveAdmin() && resource.data.status == 'pending');

      allow list: if isActiveAdmin()
        && resource.data.status == 'pending';

      allow create: if isActiveOwner()
        && ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'status',
          'submittedAt',
          'updatedAt',
          'rejectionReason',
          'ownerDisplayName',
          'ownerEmail'
        ])
        && hasValidPendingVerificationRequest(request.resource.data, ownerId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus in ['notRequested', 'rejected']
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'pending';

      allow update: if (isActiveOwner()
          && ownerId == request.auth.uid
          && resource.data.ownerId == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.keys().hasOnly([
            'ownerId',
            'status',
            'submittedAt',
            'updatedAt',
            'rejectionReason',
            'ownerDisplayName',
            'ownerEmail'
          ])
          && hasValidPendingVerificationRequest(request.resource.data, ownerId)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'rejected'
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'pending')
        || isAdminVerificationRequestUpdate(ownerId);

      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isActiveOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isVerifiedActiveOwner() {
      return isActiveOwner()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'approved';
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isAdminReadingPendingOwner(userId) {
      return isActiveAdmin()
        && resource.data.uid == userId
        && resource.data.role == 'owner'
        && resource.data.isActive == true
        && resource.data.verificationStatus == 'pending'
        && exists(/databases/$(database)/documents/verificationRequests/$(userId))
        && get(/databases/$(database)/documents/verificationRequests/$(userId)).data.ownerId == userId
        && get(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == 'pending';
    }

    function isActiveCustomer() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function hasSavedRoom(roomId) {
      return isActiveCustomer()
        && exists(/databases/$(database)/documents/savedRooms/$(request.auth.uid + '_' + roomId));
    }

    function hasValidRoomFields(data) {
      return data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 150
        && data.location is string
        && data.location.size() > 0
        && data.location.size() <= 200
        && data.monthlyRent is number
        && data.monthlyRent > 0
        && data.monthlyRent <= 1000000000
        && data.genderPreference is string
        && data.genderPreference.size() <= 50
        && data.description is string
        && data.description.size() <= 5000
        && data.imageUrls is list
        && data.imageUrls.size() <= 10
        && data.isAvailable is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomAvailabilityUpdate() {
      return isVerifiedActiveOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isAvailable',
          'updatedAt'
        ])
        && request.resource.data.isAvailable is bool
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRoomDetailsUpdate() {
      return isVerifiedActiveOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'title',
          'location',
          'monthlyRent',
          'genderPreference',
          'description',
          'imageUrls',
          'isAvailable',
          'createdAt',
          'updatedAt'
        ])
        && hasValidRoomFields(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidInquiryFields(data) {
      return data.roomId is string
        && data.roomId.size() > 0
        && data.roomId.size() <= 128
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 128
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
        && data.type in ['inquiry', 'visitRequest']
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 2000
        && data.status in [
          'pending',
          'accepted',
          'declined',
          'completed',
          'cancelled'
        ]
        && (data.scheduledVisitAt == null
          || data.scheduledVisitAt is timestamp)
        && data.hiddenByCustomer is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.roomTitle is string
        && data.roomTitle.size() > 0
        && data.roomTitle.size() <= 150
        && data.roomLocation is string
        && data.roomLocation.size() > 0
        && data.roomLocation.size() <= 200
        && data.customerDisplayName is string
        && data.customerDisplayName.size() > 0
        && data.customerDisplayName.size() <= 120;
    }

    function isSafeOwnProfileUpdate(userId) {
      return isSignedIn()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'phoneNumber',
          'updatedAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }

    function isVerificationSubmissionUserUpdate(userId) {
      return isSignedIn()
        && isOwner(userId)
        && resource.data.role == 'owner'
        && resource.data.isActive == true
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verificationStatus',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && ((resource.data.verificationStatus == 'notRequested'
            && !exists(/databases/$(database)/documents/verificationRequests/$(userId)))
          || (resource.data.verificationStatus == 'rejected'
            && exists(/databases/$(database)/documents/verificationRequests/$(userId))
            && get(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == 'rejected'))
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.submittedAt == request.time
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.rejectionReason == null;
    }

    function isAdminVerificationUserUpdate(userId) {
      return isActiveAdmin()
        && resource.data.uid == userId
        && resource.data.role == 'owner'
        && resource.data.isActive == true
        && resource.data.verificationStatus == 'pending'
        && request.resource.data.verificationStatus in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verificationStatus',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/verificationRequests/$(userId))
        && get(/databases/$(database)/documents/verificationRequests/$(userId)).data.ownerId == userId
        && get(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.ownerId == userId
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.status == request.resource.data.verificationStatus
        && getAfter(/databases/$(database)/documents/verificationRequests/$(userId)).data.updatedAt == request.time;
    }

    function isAdminVerificationRequestUpdate(ownerId) {
      return isActiveAdmin()
        && resource.data.ownerId == ownerId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'rejectionReason',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'approved'
            && request.resource.data.rejectionReason == null)
          || (request.resource.data.status == 'rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 1
            && request.resource.data.rejectionReason.size() <= 500))
        && exists(/databases/$(database)/documents/users/$(ownerId))
        && get(/databases/$(database)/documents/users/$(ownerId)).data.uid == ownerId
        && get(/databases/$(database)/documents/users/$(ownerId)).data.role == 'owner'
        && get(/databases/$(database)/documents/users/$(ownerId)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(ownerId)).data.verificationStatus == 'pending'
        && getAfter(/databases/$(database)/documents/users/$(ownerId)).data.uid == ownerId
        && getAfter(/databases/$(database)/documents/users/$(ownerId)).data.role == 'owner'
        && getAfter(/databases/$(database)/documents/users/$(ownerId)).data.isActive == true
        && getAfter(/databases/$(database)/documents/users/$(ownerId)).data.verificationStatus == request.resource.data.status
        && getAfter(/databases/$(database)/documents/users/$(ownerId)).data.updatedAt == request.time;
    }

    function hasValidPendingVerificationRequest(data, ownerId) {
      return data.ownerId == request.auth.uid
        && ownerId == request.auth.uid
        && data.status == 'pending'
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && data.rejectionReason == null
        && data.ownerDisplayName is string
        && data.ownerDisplayName.size() > 0
        && data.ownerDisplayName.size() <= 120
        && data.ownerDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
        && data.ownerEmail is string
        && data.ownerEmail.size() > 0
        && data.ownerEmail.size() <= 320
        && data.ownerEmail == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email;
    }

    function isValidCustomerInquiryUpdate() {
      return isActiveCustomer()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hiddenByCustomer',
          'updatedAt'
        ])
        && resource.data.hiddenByCustomer == false
        && request.resource.data.hiddenByCustomer == true
        && request.resource.data.updatedAt == request.time;
    }

    function isValidOwnerInquiryStatusUpdate() {
      return isVerifiedActiveOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && isValidOwnerStatusTransition(
          resource.data.status,
          request.resource.data.status
        );
    }

    function isValidOwnerVisitSchedulingUpdate() {
      return isVerifiedActiveOwner()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'scheduledVisitAt',
          'updatedAt'
        ])
        && resource.data.type == 'visitRequest'
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'accepted'
        && request.resource.data.scheduledVisitAt is timestamp
        && request.resource.data.scheduledVisitAt > request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidOwnerStatusTransition(from, to) {
      return (from == 'pending' && to in ['accepted', 'declined'])
        || (from == 'accepted' && to == 'completed');
    }
  }
}
